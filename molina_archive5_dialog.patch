diff --git a/app/src/main/java/com/molina/studio/cinema/ArchiveOps.kt b/app/src/main/java/com/molina/studio/cinema/ArchiveOps.kt
new file mode 100644
index 0000000..ef7daa9
--- /dev/null
+++ b/app/src/main/java/com/molina/studio/cinema/ArchiveOps.kt
@@ -0,0 +1,22 @@
+package com.molina.studio.cinema
+
+import android.content.Context
+import java.io.File
+
+/**
+ * [ARCHIVE5] Penghubung UI -> mesin arsip. Memilih [ArchiveEngine] atau [DebianArchive] lewat [ArchiveRoute];
+ * bentuk hasil dan galat identik sehingga dialog dan runOp tidak perlu tahu mesin mana yang bekerja.
+ * Blocking: panggil dari Dispatchers.IO.
+ */
+internal object ArchiveOps {
+    fun list(ctx: Context, file: File, password: String? = null): FileOps.ZipListing =
+        if (ArchiveRoute.viaDebian(file.name)) DebianArchive(ctx).list(file, password)
+        else ArchiveEngine.list(file, password)
+
+    fun extract(
+        ctx: Context, file: File, destDir: File, target: ExtractTarget, ctl: FileOps.Ctl,
+        password: String? = null, only: Set<String>? = null,
+    ): ExtractResult =
+        if (ArchiveRoute.viaDebian(file.name)) DebianArchive(ctx).extract(file, destDir, target, ctl, password, only)
+        else ArchiveEngine.extract(file, destDir, target, ctl, password, only)
+}
diff --git a/app/src/main/java/com/molina/studio/cinema/ArchiveRoute.kt b/app/src/main/java/com/molina/studio/cinema/ArchiveRoute.kt
new file mode 100644
index 0000000..131b5b1
--- /dev/null
+++ b/app/src/main/java/com/molina/studio/cinema/ArchiveRoute.kt
@@ -0,0 +1,22 @@
+package com.molina.studio.cinema
+
+/**
+ * [ARCHIVE5] Keputusan satu pintu: berkas ini arsip? lewat mesin mana? Murni (tanpa Android) supaya bisa diuji JVM.
+ * Mesin bawaan ([ArchiveEngine]: ZIP, 7z, tar, gz/bz2/xz) SELALU didahulukan; [DebianFormats] hanya untuk sisanya
+ * (RAR, ISO, CAB, multi-bagian, ...). Dengan begitu perilaku format lama tidak berubah sama sekali.
+ */
+internal object ArchiveRoute {
+    fun supports(name: String): Boolean = ArchiveNames.detect(name) != null || DebianFormats.supports(name)
+
+    /** True bila berkas hanya bisa dibuka lewat 7z di Debian. */
+    fun viaDebian(name: String): Boolean = ArchiveNames.detect(name) == null && DebianFormats.supports(name)
+
+    /** Label format untuk judul dialog ("7Z", "RAR", ...), atau null bila bukan arsip. */
+    fun label(name: String): String? = ArchiveNames.detect(name)?.label ?: DebianFormats.detect(name)?.label
+
+    /** Nama subfolder tujuan ekstrak. */
+    fun folderName(name: String): String = if (viaDebian(name)) DebianFormats.folderName(name) else ArchiveNames.folderName(name)
+
+    /** Apakah dialog perlu menawarkan kata sandi bila isi terenkripsi. Format Debian (RAR/7z/ZIP multi-bagian) bisa berkata sandi. */
+    fun canPassword(name: String): Boolean = ArchiveNames.detect(name)?.hasPassword ?: DebianFormats.supports(name)
+}
