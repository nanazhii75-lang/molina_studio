<?xml version="1.0" encoding="utf-8"?>
<!-- Molina: menu atas ringkas dengan ikon. ID tombol sama seperti sebelumnya (MPVActivity.openTopMenu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Since this dialog does not scroll, don't add too many buttons here! -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

<Button
        android:id="@+id/audioBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_audio_file"
        android:text="@string/open_external_audio" />

<Button
        android:id="@+id/subBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_subtitles"
        android:text="@string/open_external_sub" />

    </LinearLayout>

    <Button
        android:id="@+id/playlistBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_playlist"
        android:text="@string/action_playlist" />

    <LinearLayout
        android:id="@+id/rowMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

<Button
        android:id="@+id/backgroundBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_headset"
        android:text="@string/resume_bg_playback" />

<Button
        android:id="@+id/audioOnlyBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_audiotrack"
        android:text="@string/audio_only_on" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowChapter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/chapterBtn"
            style="@style/Widget.Molina.MenuItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:drawableStart="@drawable/ic_menu_chapters"
            android:text="@string/chapter_button" />

        <Button
            android:id="@+id/chapterPrev"
            style="@style/Widget.Molina.MenuItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/alpha_lighten"
            android:text="@string/dialog_prev" />

        <Button
            android:id="@+id/chapterNext"
            style="@style/Widget.Molina.MenuItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/alpha_lighten"
            android:text="@string/dialog_next" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

<Button
        android:id="@+id/advancedBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_tune"
        android:text="@string/advanced_menu" />

<Button
        android:id="@+id/orientationBtn"
        style="@style/Widget.Molina.MenuItem"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_menu_rotate"
        android:text="@string/switch_orientation" />

    </LinearLayout>

</LinearLayout>
