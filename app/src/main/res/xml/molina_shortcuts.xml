<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="molina_cinema"
        android:enabled="true"
        android:icon="@mipmap/ic_cinema_launcher"
        android:shortcutShortLabel="@string/shortcut_cinema_short"
        android:shortcutLongLabel="@string/shortcut_cinema_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.molina.studio"
            android:targetClass="com.molina.studio.MainActivity">
            <extra android:name="molina_open_tab" android:value="cinema" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="molina_terminal"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_terminal_short"
        android:shortcutLongLabel="@string/shortcut_terminal_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.molina.studio"
            android:targetClass="com.molina.studio.MainActivity">
            <extra android:name="molina_open_tab" android:value="terminal" />
        </intent>
    </shortcut>
    <!-- Code: shortcut dinamis (MolinaShortcuts.kt), bukan statis -->
</shortcuts>
