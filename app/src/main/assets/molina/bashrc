# Molina Terminal - dibuat otomatis oleh aplikasi. Jangan diedit manual (ditimpa tiap sesi baru).
[ -f /etc/profile ] && . /etc/profile
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

# [DIR-STATUS-COLOR v5]
# Prompt: hijau + label [MOLINA] HANYA di home internal aplikasi (/sdcard/Molina dan isinya).
# Hijau (tanpa label) juga di home ($HOME = ~) dan isinya: prompt user@localhost:~ default.
# Merah di mana pun selain itu, termasuk project /sdcard/molina-studio.
# Semua alias path penyimpanan disamakan ke /sdcard/... sebelum dicocokkan.
__molina_ps1() {
  [ -r /etc/molina/prompt.env ] && . /etc/molina/prompt.env
  printf '%s\n' "$PWD" > /etc/molina/lastdir 2>/dev/null
  local sgr="$MOLINA_PS_OTHER" tag="" p="$PWD"
  case "$p" in
    /storage/emulated/0|/storage/emulated/0/*) p="/sdcard${p#/storage/emulated/0}" ;;
    /storage/self/primary|/storage/self/primary/*) p="/sdcard${p#/storage/self/primary}" ;;
    /mnt/sdcard|/mnt/sdcard/*) p="/sdcard${p#/mnt/sdcard}" ;;
  esac
  case "$PWD" in
    "$HOME"|"$HOME"/*) [ -n "$HOME" ] && [ "$HOME" != / ] && sgr="$MOLINA_PS_HOME" ;;
  esac
  case "$p" in
    /sdcard/Molina|/sdcard/Molina/*) sgr="$MOLINA_PS_HOME"; tag="[MOLINA] " ;;
  esac
  PS1='\[\e['"$sgr"'m\]'"$tag"'user@localhost:\w $\[\e[0m\] '
}
PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__molina_ps1"

# Tombol CLEAR aplikasi mengirim ESC [ 9 9 ~ agar prompt digambar ulang setelah layar dibersihkan.
bind '"\e[99~": redraw-current-line' 2>/dev/null

# Banner berbingkai; HARUS sama dengan MolinaShell.banner (Kotlin).
__molina_banner() {
  [ -r /etc/molina/prompt.env ] && . /etc/molina/prompt.env # warna tema prompt aktif (MOLINA_PS_HOME)
  local t="$MOLINA_BRAND" b="${MOLINA_PS_HOME:-$MOLINA_BRAND_SGR}" bar
  local f="${b#1;}"
  printf -v bar '%*s' $((${#t} + 4)) ''
  bar="${bar// /─}"
  printf '\033[%sm╭%s╮\033[0m\n' "$f" "$bar"
  printf '\033[%sm│\033[0m  \033[%sm%s\033[0m  \033[%sm│\033[0m\n' "$f" "$b" "$t" "$f"
  printf '\033[%sm╰%s╯\033[0m\n' "$f" "$bar"
}
__molina_banner
